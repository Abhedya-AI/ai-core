# ===========================
# APPLICATION  (prefix: APP_)
# ===========================
APP_NAME=ABHEDYA AI Core
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1

# ===========================
# POSTGRES  (prefix: POSTGRES_)
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=abhedya
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ===========================
# NEO4J  (prefix: NEO4J_)
# ===========================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ===========================
# REDIS  (prefix: REDIS_)
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# LLM  (prefix: LLM_ / provider API keys keep their own names)
# ===========================
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===========================
# KAFKA  (prefix: KAFKA_)
# ===========================
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=abhedya
KAFKA_CONSUMER_GROUP=abhedya-group

# ===========================
# LOGGING  (prefix: LOG_)
# ===========================
LOG_LEVEL=INFO
LOG_JSON_LOGS=false
LOG_FILE=
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# ===========================
# SECURITY  (conventional names, no prefix)
# ===========================
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

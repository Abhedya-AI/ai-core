# ===========================
# APPLICATION
# ===========================

APP_NAME=ABHEDYA
APP_ENV=development
APP_DEBUG=True
API_VERSION=v1

HOST=0.0.0.0
PORT=8000

# ===========================
# POSTGRES
# ===========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=abhedya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ===========================
# NEO4J
# ===========================

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ===========================
# REDIS
# ===========================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================
# LLM PROVIDER
# ===========================

LLM_PROVIDER=gemini            # gemini | groq | openai | azure

# ===========================
# GEMINI (Primary)
# ===========================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===========================
# GROQ (Fallback)
# ===========================

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================
# OPENAI (Future)
# ===========================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ===========================
# AZURE OPENAI (Future)
# ===========================

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# ===========================
# EMBEDDINGS
# ===========================

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===========================
# SECURITY
# ===========================

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# LOGGING
# ===========================

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=

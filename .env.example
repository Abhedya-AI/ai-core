# ===========================
# APPLICATION
# ===========================
APP_NAME=ABHEDYA
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=True
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ===========================
# POSTGRES
# ===========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=abhedya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_CONNECT_TIMEOUT=3

# ===========================
# NEO4J
# ===========================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=5

# ===========================
# REDIS
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=3
REDIS_CONNECT_TIMEOUT=3
REDIS_MAX_CONNECTIONS=10

# ===========================
# VECTOR STORE
# ===========================
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=faiss_index
VECTOR_DIMENSION=1024

# ===========================
# LLM PROVIDER
# ===========================
# Options: gemini | groq | openai | azure
LLM_PROVIDER=gemini
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# ===========================
# GEMINI (Primary)
# ===========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# ===========================
# GROQ (Fallback)
# ===========================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================
# OPENAI (Future)
# ===========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ===========================
# AZURE OPENAI (Future)
# ===========================
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================
# EMBEDDINGS
# ===========================
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# ===========================
# KAFKA (Milestone 6+)
# ===========================
KAFKA_ENABLED=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=abhedya-core
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_TOPIC_ALERTS=abhedya.alerts
KAFKA_TOPIC_INCIDENTS=abhedya.incidents
KAFKA_TOPIC_AUDIT=abhedya.audit
KAFKA_TOPIC_GEO=abhedya.geo

# ===========================
# SECURITY
# ===========================
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_ENABLED=False
API_KEY=
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=60

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_SERIALIZE=False
LOG_BACKTRACE=True
LOG_DIAGNOSE=False
